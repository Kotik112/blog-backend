packages:
  yum:
    nginx: []
    certbot: []

files:
  "/etc/nginx/conf.d/00_http.conf":
    mode: "000644"
    owner: root
    group: root
    content: |
      server {
          listen 80;
          server_name ${DOMAIN};

          location /.well-known/acme-challenge/ {
              root /var/www/html;
          }

          location / {
              return 301 https://${DOMAIN}$request_uri;
          }
      }

commands:
  00_remove_default_conf:
    command: |
      rm -f /etc/nginx/conf.d/default.conf

  01_start_nginx:
    command: |
      nginx -t || (cat /etc/nginx/conf.d/*.conf && exit 1)
      service nginx start

  02_create_cert:
    command: |
      mkdir -p /var/www/html
      certbot certonly --webroot -w /var/www/html \
        --non-interactive --agree-tos \
        -m ${EMAIL} \
        -d ${DOMAIN}

  03_add_ssl_if_exists:
    command: |
      CERT_PATH="/etc/letsencrypt/live/${DOMAIN}/fullchain.pem"
      if [ -f "$CERT_PATH" ]; then
        echo "✓ Found certificate, adding HTTPS config"

        cat > /etc/nginx/conf.d/01_ssl.conf <<EOF
server {
    listen 443 ssl;
    server_name ${DOMAIN};

    ssl_certificate /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;

    location / {
        proxy_pass http://localhost:5000;
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;
    }
}
EOF

      else
        echo "❌ Certificate not found at $CERT_PATH. Skipping HTTPS config."
      fi

  04_restart_nginx:
    command: |
      nginx -t || (cat /etc/nginx/conf.d/*.conf && exit 1)
      service nginx restart
